# ─── NEXORA Server Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is git-ignored — NEVER commit real secrets.

# Server port (default: 5000)
PORT=5000

# Environment mode — set to "production" for deployment
# Controls: error verbosity, rate limiting, CORS strictness
NODE_ENV=development

# MongoDB connection string (required)
# Example: mongodb+srv://user:pass@cluster.mongodb.net/nexora
MONGO_URI=

# JWT secret key for signing tokens (required — use a strong random string)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# JWT token expiry (default: 7d)
JWT_EXPIRES_IN=7d

# Frontend URL for CORS (default: http://localhost:5173 for Vite dev server)
# In production, set this to the deployed frontend URL
CLIENT_URL=http://localhost:5173
